library (encoder_lib) {
  slew_derate_from_library : 1.0;
  slew_lower_threshold_pct_fall : 20.0;
  slew_upper_threshold_pct_fall : 80.0;
  slew_lower_threshold_pct_rise : 20.0;
  slew_upper_threshold_pct_rise : 80.0;
  input_threshold_pct_fall : 50.0;
  input_threshold_pct_rise : 50.0;
  output_threshold_pct_fall : 50.0;
  output_threshold_pct_rise : 50.0;
  cell (encoder) {
    area : 1402;
    pin (vdd) {
      direction : inout;
      pg_type : primary_power;
    }
    pin (vss) {
      direction : inout;
      pg_type : primary_ground;
    }
    pin (Vin) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Vin_neg) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Iex_1_i) {
      direction : output;
      capacitance : 0.001;
    }
    pin (Iex_2_i) {
      direction : output;
      capacitance : 0.001;
    }
    pin (Iex_3_i) {
      direction : output;
      capacitance : 0.001;
    }
    pin (Iex_4_i) {
      direction : output;
      capacitance : 0.001;
    }
  }
}
