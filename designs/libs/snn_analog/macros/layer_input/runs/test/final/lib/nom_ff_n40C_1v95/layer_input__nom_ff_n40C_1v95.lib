library (layer_input) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 1.95;


  cell ("layer_input") {
    area : 6663.200 
    is_macro_cell : true;
    pin("Iext1") {
      direction : input;
      capacitance : 0.0071;
    }
    pin("Iext2") {
      direction : input;
      capacitance : 0.0053;
    }
    pin("Iext3") {
      direction : input;
      capacitance : 0.0063;
    }
    pin("Iext4") {
      direction : input;
      capacitance : 0.0059;
    }
    pin("nvout_1") {
      direction : output;
      capacitance : 0.0059;
    }
    pin("nvout_2") {
      direction : output;
      capacitance : 0.0032;
    }
    pin("nvout_3") {
      direction : output;
      capacitance : 0.0033;
    }
    pin("nvout_4") {
      direction : output;
      capacitance : 0.0060;
    }
    pin("vout_1") {
      direction : output;
      capacitance : 0.0078;
    }
    pin("vout_2") {
      direction : output;
      capacitance : 0.0076;
    }
    pin("vout_3") {
      direction : output;
      capacitance : 0.0066;
    }
    pin("vout_4") {
      direction : output;
      capacitance : 0.0064;
    }
  }

}
