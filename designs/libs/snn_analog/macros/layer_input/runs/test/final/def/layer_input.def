VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN layer_input ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 70000 180000 ) ;
ROW ROW_55 unithd 5520 160480 FS DO 128 BY 1 STEP 460 0 ;
ROW ROW_56 unithd 5520 163200 N DO 128 BY 1 STEP 460 0 ;
ROW ROW_57 unithd 5520 165920 FS DO 128 BY 1 STEP 460 0 ;
TRACKS X 230 DO 152 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 529 STEP 340 LAYER li1 ;
TRACKS X 170 DO 206 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 529 STEP 340 LAYER met1 ;
TRACKS X 230 DO 152 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 391 STEP 460 LAYER met2 ;
TRACKS X 340 DO 103 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 264 STEP 680 LAYER met3 ;
TRACKS X 460 DO 76 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 195 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 20 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 53 STEP 3400 LAYER met5 ;
GCELLGRID X 0 DO 10 STEP 6900 ;
GCELLGRID Y 0 DO 26 STEP 6900 ;
VIAS 2 ;
    - via4_5_1600_1600_4_4_400_400 + VIARULE M3M4_PR + CUTSIZE 200 200  + LAYERS met3 via3 met4  + CUTSPACING 200 200  + ENCLOSURE 90 100 100 65  + ROWCOL 4 4  ;
    - via4_5_1600_1000_2_4_400_400 + VIARULE M3M4_PR + CUTSIZE 200 200  + LAYERS met3 via3 met4  + CUTSPACING 200 200  + ENCLOSURE 100 200 100 65  + ROWCOL 2 4  ;
END VIAS
NONDEFAULTRULES 1 ;
    - ndr_safe_spacing
      + LAYER li1 WIDTH 170
      + LAYER met1 WIDTH 140
      + LAYER met2 WIDTH 140
      + LAYER met3 WIDTH 300 SPACING 1100
      + LAYER met4 WIDTH 300
      + LAYER met5 WIDTH 1600
    ;
END NONDEFAULTRULES
COMPONENTS 4 ;
    - x1 neurona + FIXED ( 10000 130000 ) N ;
    - x2 neurona + FIXED ( 10000 90000 ) N ;
    - x3 neurona + FIXED ( 10000 50000 ) N ;
    - x4 neurona + FIXED ( 10000 10000 ) N ;
END COMPONENTS
