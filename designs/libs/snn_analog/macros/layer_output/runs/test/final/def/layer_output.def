VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN layer_output ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 130000 50000 ) ;
ROW ROW_1_3 unithd 118220 13600 FS DO 13 BY 1 STEP 460 0 ;
ROW ROW_2_3 unithd 118220 16320 N DO 13 BY 1 STEP 460 0 ;
ROW ROW_3_3 unithd 118220 19040 FS DO 13 BY 1 STEP 460 0 ;
ROW ROW_4_3 unithd 118220 21760 N DO 13 BY 1 STEP 460 0 ;
ROW ROW_5_3 unithd 118220 24480 FS DO 13 BY 1 STEP 460 0 ;
ROW ROW_6_3 unithd 118220 27200 N DO 13 BY 1 STEP 460 0 ;
ROW ROW_7_3 unithd 118220 29920 FS DO 13 BY 1 STEP 460 0 ;
ROW ROW_8_3 unithd 118220 32640 N DO 13 BY 1 STEP 460 0 ;
ROW ROW_9_3 unithd 118220 35360 FS DO 13 BY 1 STEP 460 0 ;
ROW ROW_0_3 unithd 118220 10880 N DO 13 BY 1 STEP 460 0 ;
TRACKS X 230 DO 282 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 147 STEP 340 LAYER li1 ;
TRACKS X 170 DO 382 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 147 STEP 340 LAYER met1 ;
TRACKS X 230 DO 282 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 109 STEP 460 LAYER met2 ;
TRACKS X 340 DO 191 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 73 STEP 680 LAYER met3 ;
TRACKS X 460 DO 141 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 54 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 38 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 14 STEP 3400 LAYER met5 ;
GCELLGRID X 0 DO 18 STEP 6900 ;
GCELLGRID Y 0 DO 7 STEP 6900 ;
VIAS 2 ;
    - via4_5_1600_1600_4_4_400_400 + VIARULE M3M4_PR + CUTSIZE 200 200  + LAYERS met3 via3 met4  + CUTSPACING 200 200  + ENCLOSURE 90 100 100 65  + ROWCOL 4 4  ;
    - via4_5_1600_1000_2_4_400_400 + VIARULE M3M4_PR + CUTSIZE 200 200  + LAYERS met3 via3 met4  + CUTSPACING 200 200  + ENCLOSURE 100 200 100 65  + ROWCOL 2 4  ;
END VIAS
NONDEFAULTRULES 1 ;
    - ndr_safe_spacing
      + LAYER li1 WIDTH 170
      + LAYER met1 WIDTH 140
      + LAYER met2 WIDTH 140
      + LAYER met3 WIDTH 300 SPACING 1100
      + LAYER met4 WIDTH 300
      + LAYER met5 WIDTH 1600
    ;
END NONDEFAULTRULES
COMPONENTS 2 ;
    - x1 neurona + FIXED ( 10000 10000 ) N ;
    - x2 neurona + FIXED ( 65000 10000 ) N ;
END COMPONENTS
PINS 8 ;
    - Iext1 + NET Iext1 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -700 -750 ) ( 700 750 )
        + PLACED ( 31510 49250 ) N ;
    - Iext2 + NET Iext2 + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -700 -750 ) ( 700 750 )
        + PLACED ( 95910 49250 ) N ;
    - nvout_1 + NET nvout_1 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -700 -750 ) ( 700 750 )
        + PLACED ( 48070 750 ) N ;
    - nvout_2 + NET nvout_2 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -700 -750 ) ( 700 750 )
        + PLACED ( 110630 750 ) N ;
    - vdd + NET vdd + SPECIAL + DIRECTION INOUT + USE POWER
      + PORT
        + LAYER met4 ( -800 -24400 ) ( 800 24400 )
        + LAYER met4 ( -60800 -24400 ) ( -59200 24400 )
        + LAYER met3 ( -80800 7600 ) ( 59480 9200 )
        + LAYER met4 ( 54680 -21200 ) ( 56280 21200 )
        + LAYER met4 ( -77600 -21200 ) ( -76000 21200 )
        + LAYER met3 ( -77600 19600 ) ( 56280 21200 )
        + LAYER met3 ( -77600 -21200 ) ( 56280 -19600 )
        + FIXED ( 75520 24480 ) N ;
    - vout_1 + NET vout_1 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -700 -750 ) ( 700 750 )
        + PLACED ( 16790 750 ) N ;
    - vout_2 + NET vout_2 + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -700 -750 ) ( 700 750 )
        + PLACED ( 79350 750 ) N ;
    - vss + NET vss + SPECIAL + DIRECTION INOUT + USE GROUND
      + PORT
        + LAYER met4 ( -800 -24400 ) ( 800 24400 )
        + LAYER met4 ( -60800 -24400 ) ( -59200 24400 )
        + LAYER met3 ( -84400 11200 ) ( 55880 12800 )
        + LAYER met4 ( 54280 -24400 ) ( 55880 24400 )
        + LAYER met4 ( -84400 -24400 ) ( -82800 24400 )
        + LAYER met3 ( -84400 22800 ) ( 55880 24400 )
        + LAYER met3 ( -84400 -24400 ) ( 55880 -22800 )
        + FIXED ( 79120 24480 ) N ;
END PINS
SPECIALNETS 2 ;
    - vdd ( PIN vdd ) + USE POWER
      + ROUTED met3 0 + SHAPE STRIPE ( 75520 28955 ) via4_5_1600_1000_2_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 15520 28955 ) via4_5_1600_1000_2_4_400_400
      NEW met4 1600 + SHAPE STRIPE ( 75520 80 ) ( 75520 48880 )
      NEW met4 1600 + SHAPE STRIPE ( 15520 80 ) ( 15520 48880 )
      NEW met3 1600 + SHAPE STRIPE ( -5280 32880 ) ( 135000 32880 )
      NEW met4 1600 + SHAPE RING ( 131000 3280 ) ( 131000 45680 )
      NEW met4 1600 + SHAPE RING ( -1280 3280 ) ( -1280 45680 )
      NEW met3 1600 + SHAPE RING ( -2080 44880 ) ( 131800 44880 )
      NEW met3 1600 + SHAPE RING ( -2080 4080 ) ( 131800 4080 )
      NEW met3 0 + SHAPE RING ( 131000 44880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 131000 32880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE RING ( 131000 4080 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 75520 44880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 75520 32880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 75520 4080 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 15520 44880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 15520 32880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 15520 4080 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE RING ( -1280 44880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( -1280 32880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE RING ( -1280 4080 ) via4_5_1600_1600_4_4_400_400 ;
    - vss ( PIN vss ) + USE GROUND
      + ROUTED met3 0 + SHAPE STRIPE ( 79120 10750 ) via4_5_1600_1000_2_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 19120 10750 ) via4_5_1600_1000_2_4_400_400
      NEW met4 1600 + SHAPE STRIPE ( 79120 80 ) ( 79120 48880 )
      NEW met4 1600 + SHAPE STRIPE ( 19120 80 ) ( 19120 48880 )
      NEW met3 1600 + SHAPE STRIPE ( -5280 36480 ) ( 135000 36480 )
      NEW met4 1600 + SHAPE RING ( 134200 80 ) ( 134200 48880 )
      NEW met4 1600 + SHAPE RING ( -4480 80 ) ( -4480 48880 )
      NEW met3 1600 + SHAPE RING ( -5280 48080 ) ( 135000 48080 )
      NEW met3 1600 + SHAPE RING ( -5280 880 ) ( 135000 880 )
      NEW met3 0 + SHAPE RING ( 134200 48080 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 134200 36480 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE RING ( 134200 880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 79120 48080 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 79120 36480 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 79120 880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 19120 48080 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 19120 36480 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( 19120 880 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE RING ( -4480 48080 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE STRIPE ( -4480 36480 ) via4_5_1600_1600_4_4_400_400
      NEW met3 0 + SHAPE RING ( -4480 880 ) via4_5_1600_1600_4_4_400_400 ;
END SPECIALNETS
NETS 8 ;
    - Iext1 ( PIN Iext1 ) ( x1 Iin ) + USE SIGNAL + NONDEFAULTRULE ndr_safe_spacing
      + ROUTED met2 ( 31970 39100 ) ( * 48620 0 )
      NEW met3 ( 48070 26860 ) ( 48300 * )
      NEW met4 ( 48300 25500 0 ) ( * 26860 )
      NEW met3 ( 31970 39100 ) ( 48070 * )
      NEW met2 ( 48070 26860 ) ( * 39100 )
      NEW met2 ( 31970 39100 ) M2M3_PR
      NEW met2 ( 48070 26860 ) M2M3_PR
      NEW met3 ( 48300 26860 ) M3M4_PR
      NEW met2 ( 48070 39100 ) M2M3_PR
      NEW met3 TAPER ( 48070 26860 ) RECT ( -390 -150 0 150 )  ;
    - Iext2 ( PIN Iext2 ) ( x2 Iin ) + USE SIGNAL + NONDEFAULTRULE ndr_safe_spacing
      + ROUTED met3 ( 96140 18700 ) ( 96370 * )
      NEW met4 ( 96140 18700 ) ( * 22100 0 )
      NEW met2 ( 96370 18700 ) ( * 48620 0 )
      NEW met2 ( 96370 18700 ) M2M3_PR
      NEW met3 ( 96140 18700 ) M3M4_PR
      NEW met3 TAPER ( 96370 18700 ) RECT ( 0 -150 390 150 )  ;
    - nvout_1 ( PIN nvout_1 ) ( x1 spike_neg ) + USE SIGNAL + NONDEFAULTRULE ndr_safe_spacing
      + ROUTED met2 ( 47610 1020 0 ) ( * 22270 )
      NEW met1 ( 47610 22270 ) M1M2_PR ;
    - nvout_2 ( PIN nvout_2 ) ( x2 spike_neg ) + USE SIGNAL + NONDEFAULTRULE ndr_safe_spacing
      + ROUTED met2 ( 111090 1020 0 ) ( * 6460 )
      NEW met2 ( 75670 6460 ) ( * 14790 )
      NEW met3 ( 75670 6460 ) ( 111090 * )
      NEW met2 ( 111090 6460 ) M2M3_PR
      NEW met2 ( 75670 6460 ) M2M3_PR
      NEW met1 ( 75670 14790 ) M1M2_PR ;
    - vdd ( PIN vdd ) ( x2 vdd ) ( x1 vdd ) + USE POWER + NONDEFAULTRULE ndr_safe_spacing ;
    - vout_1 ( PIN vout_1 ) ( x1 spike ) + USE SIGNAL + NONDEFAULTRULE ndr_safe_spacing
      + ROUTED met2 ( 17250 1020 0 ) ( 19090 * )
      NEW met2 ( 19090 1020 ) ( * 17340 )
      NEW met3 ( 19090 17340 ) ( 26220 * )
      NEW met2 ( 19090 17340 ) M2M3_PR
      NEW met2 ( 26220 17340 ) M2M3_PR_M ;
    - vout_2 ( PIN vout_2 ) ( x2 spike ) + USE SIGNAL + NONDEFAULTRULE ndr_safe_spacing
      + ROUTED met2 ( 79810 1020 0 ) ( * 8500 )
      NEW met3 ( 79810 8500 ) ( 81420 * )
      NEW met4 ( 81420 8500 ) ( * 17340 )
      NEW met3 ( 81190 17340 ) ( 81420 * )
      NEW met2 ( 79810 8500 ) M2M3_PR
      NEW met3 ( 81420 8500 ) M3M4_PR
      NEW met3 ( 81420 17340 ) M3M4_PR
      NEW met2 ( 81190 17340 ) M2M3_PR_MR
      NEW met3 TAPER ( 81420 17340 ) RECT ( 0 -150 390 150 )  ;
    - vss ( PIN vss ) ( x2 vss ) ( x1 vss ) + USE GROUND + NONDEFAULTRULE ndr_safe_spacing ;
END NETS
END DESIGN
